# Copy this file to `.env.development` for local work, or `.env.production` for production builds.
# All client-side variables must be prefixed with VITE_.

# Application environment label (development | staging | production)
VITE_APP_ENV=development

# Backend API base URL (must include trailing slash)
VITE_API_BASE_URL=https://localhost:7248/api/

# Chart-of-accounts node IDs used by payment/receipt voucher forms.
# Obtain values from your backend team or GL settings API.
VITE_PAYABLE_NOTES_ID=00000000-0000-0000-0000-000000000000
VITE_RECEIVABLE_NOTES_ID=00000000-0000-0000-0000-000000000000
